# Smart Camera with Real-Time Pose Suggestion and Alignment
# Environment Configuration
#
# Copy this file to .env and change the values.
# NEVER commit .env to version control.

# Secret key for JWT token signing. Generate a random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///./smart_camera.db

# Directory for captured photos (relative to project root)
CAPTURES_DIR=./captures

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
